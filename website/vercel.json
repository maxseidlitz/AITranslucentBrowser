{
  "buildCommand": "echo 'Static HTML - no build needed'",
  "outputDirectory": ".",
  "env": {
    "FORMSPREE_ID": "@formspree_id"
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/github",
      "destination": "https://github.com/maxseidlitz/AITranslucentBrowser",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "https://github.com/maxseidlitz/AITranslucentBrowser/blob/main/README.md",
      "permanent": false
    }
  ]
}
